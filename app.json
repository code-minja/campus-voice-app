{
  "expo": {
    "name": "campus-voice",
    "slug": "campus-voice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.campusvoice",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Campus Voice uses your location to guide you across campus.",
        "NSMicrophoneUsageDescription": "Campus Voice captures audio to provide convenient interaction and voice navigation across campus."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ebebeb"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.campusvoice",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ebebeb",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Campus Voice uses your location to guide you across campus."
        }
      ],
      "expo-asset",
      "expo-audio"
    ]
  }
}