# Preferred single base URL (used to derive health/models/STT/TTS routes)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.18.3:8000
# EXPO_PUBLIC_API_BASE_URL=http://192.168.18.8:8001
EXPO_PUBLIC_API_BASE_URL="" 				# Provide a value for EXPO_PUBLIC_API_BASE_URL
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY="" 				# Provide a value for EXPO_PUBLIC_GOOGLE_MAPS_API_KEY
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID="" 				# Optional production Map ID for AdvancedMarkerElement; defaults to DEMO_MAP_ID
# Optional native keys; use keys restricted to your Android package or iOS bundle ID.
GOOGLE_MAPS_ANDROID_API_KEY=""
GOOGLE_MAPS_IOS_API_KEY=""
# Optional explicit overrides (these take priority over EXPO_PUBLIC_API_BASE_URL)
# EXPO_PUBLIC_TRANSCRIBE_URL=http://localhost:8000/v1/stt/transcribe
# EXPO_PUBLIC_TTS_URL=http://localhost:8000/v1/tts/synthesize

# Optional live-navigation tuning (defaults shown)
EXPO_PUBLIC_NAVIGATION_ANNOUNCEMENT_INTERVAL_METERS=25
EXPO_PUBLIC_NAVIGATION_ARRIVAL_RADIUS_METERS=15
EXPO_PUBLIC_NAVIGATION_MAX_GPS_ACCURACY_METERS=10
EXPO_PUBLIC_NAVIGATION_OFF_ROUTE_CONFIRMATIONS=3
EXPO_PUBLIC_NAVIGATION_OFF_ROUTE_THRESHOLD_METERS=5
